<%- include('partials/header',{title:'Surat Pengantar'}) %><div class="page-heading"><div><h1>Surat Pengantar</h1><p>Pengajuan dan persetujuan surat secara digital.</p></div></div>
<% if(user.role==='warga'){ %><div class="panel form-panel"><div class="panel-head"><div><h3>Ajukan Surat Baru</h3><p>Surat akan diteruskan ke Ketua RT, lalu Staff RW.</p></div><span class="step-pill">1. Ajukan → 2. RT → 3. RW</span></div><form method="post" action="/surat" class="form-grid"><div class="field"><label>Nama pemohon</label><select name="resident_id" required><option value="">Pilih anggota keluarga</option><% residents.forEach(r=>{ %><option value="<%= r.id %>"><%= r.name %> — <%= r.nik %></option><% }) %></select></div><div class="field"><label>Jenis surat</label><select name="letter_type" required><option value="">Pilih jenis surat</option><option>Surat Keterangan Domisili</option><option>Surat Pengantar SKCK</option><option>Surat Keterangan Usaha</option><option>Surat Keterangan Tidak Mampu</option><option>Surat Pengantar Nikah</option><option>Surat Keterangan Lainnya</option></select></div><div class="field full-field"><label>Keperluan</label><textarea name="purpose" rows="3" required placeholder="Jelaskan tujuan pengajuan surat..."></textarea></div><div class="field full-field"><label>Catatan tambahan (opsional)</label><input name="notes" placeholder="Informasi tambahan"></div><div class="full-field"><button class="btn primary">Kirim Pengajuan →</button></div></form></div><% } %>
<div class="panel"><div class="panel-head"><div><h3>Daftar Permohonan</h3><p><%= user.role==='warga'?'Riwayat pengajuan keluarga Anda.':'Surat yang perlu dipantau atau diproses.' %></p></div><span class="count-pill"><%= letters.length %> surat</span></div><div class="table-wrap"><table><thead><tr><th>No.</th><th>Pemohon</th><th>Jenis Surat</th><th>Tanggal</th><th>Status</th><th>Keperluan / Catatan</th><th>Aksi</th></tr></thead><tbody><% letters.forEach((l,i)=>{ %><tr><td><%= i+1 %></td><td><b><%= l.resident_name %></b><small class="table-sub"><%= l.nik %></small></td><td><%= l.letter_type %></td><td><%= new Date(l.created_at).toLocaleDateString('id-ID') %></td><td><span class="status <%= l.status==='Disetujui'?'approved':l.status.startsWith('Ditolak')?'rejected':'pending' %>"><%= l.status %></span><% if(l.rejection_reason){ %><small class="table-sub">Alasan: <%= l.rejection_reason %></small><% } %></td><td><%= l.purpose %><% if(l.notes){ %><small class="table-sub"><%= l.notes %></small><% } %></td><td><div class="actions"><% if(user.role==='rt' && l.status==='Menunggu RT'){ %><form method="post" action="/surat/<%= l.id %>/approval"><input type="hidden" name="action" value="approve"><button class="btn tiny success">Setujui</button></form><form method="post" action="/surat/<%= l.id %>/approval" onsubmit="return rejectLetter(this)"><input type="hidden" name="action" value="reject"><input type="hidden" name="reason"><button class="btn tiny danger">Tolak</button></form><% } else if(user.role==='rw' && l.status==='Menunggu RW'){ %><form method="post" action="/surat/<%= l.id %>/approval"><input type="hidden" name="action" value="approve"><button class="btn tiny success">Setujui</button></form><form method="post" action="/surat/<%= l.id %>/approval" onsubmit="return rejectLetter(this)"><input type="hidden" name="action" value="reject"><input type="hidden" name="reason"><button class="btn tiny danger">Tolak</button></form><% } %><% if(l.status==='Disetujui'){ %><a class="btn tiny primary" href="/surat/<%= l.id %>/download">Unduh PDF</a><% } %></div></td></tr><% }) %></tbody></table><% if(!letters.length){ %><div class="empty">Belum ada surat yang diajukan.</div><% } %></div></div><script>function rejectLetter(form){const reason=prompt('Masukkan alasan penolakan:');if(!reason||!reason.trim())return false;form.querySelector('[name=reason]').value=reason.trim();return true;}</script><%- include('partials/footer') %>