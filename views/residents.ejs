<%- include('partials/header',{title:'Data Warga'}) %><div class="page-heading"><div><h1>Data Warga</h1><p>Daftar warga sesuai cakupan wilayah Anda.</p></div><span class="count-pill"><%= residents.length %> warga</span></div><div class="panel"><div class="table-toolbar"><input id="tableSearch" class="search" placeholder="Cari nama, NIK, atau nomor KK..." oninput="filterTable()"><span class="muted">Data hanya untuk dibaca pada versi awal</span></div><div class="table-wrap"><table id="dataTable"><thead><tr><th>No</th><th>Nama Warga</th><th>NIK</th><th>No. KK</th><th>RT/RW</th><th>Jenis Kelamin</th><th>Status</th></tr></thead><tbody><% residents.forEach((r,i)=>{ %><tr><td><%= i+1 %></td><td><b><%= r.name %></b></td><td><%= r.nik %></td><td><%= r.family_card_number %></td><td><%= r.rt_number %>/<%= r.rw_number %></td><td><%= r.gender %></td><td><span class="status approved"><%= r.status %></span></td></tr><% }) %></tbody></table><% if(!residents.length){ %><div class="empty">Belum ada data warga pada wilayah ini.</div><% } %></div></div><script src="/js/app.js"></script><%- include('partials/footer') %>