<%- include('partials/header',{title:'Kartu Keluarga'}) %><div class="page-heading"><div><h1>Data Kartu Keluarga</h1><p>Ringkasan keluarga di wilayah yang Anda kelola.</p></div><span class="count-pill"><%= families.length %> keluarga</span></div><div class="panel"><div class="table-toolbar"><input id="tableSearch" class="search" placeholder="Cari kepala keluarga, nomor KK, alamat..." oninput="filterTable()"></div><div class="table-wrap"><table id="dataTable"><thead><tr><th>No</th><th>Nomor KK</th><th>Kepala Keluarga</th><th>Alamat</th><th>RT/RW</th><th>Jumlah Anggota</th></tr></thead><tbody><% families.forEach((f,i)=>{ %><tr><td><%= i+1 %></td><td><b><%= f.family_card_number %></b></td><td><%= f.head_name %></td><td><%= f.address %></td><td><%= f.rt_number %>/<%= f.rw_number %></td><td><span class="count-pill"><%= f.member_count %> orang</span></td></tr><% }) %></tbody></table><% if(!families.length){ %><div class="empty">Belum ada data keluarga.</div><% } %></div></div><script src="/js/app.js"></script><%- include('partials/footer') %>