<%- include('partials/header',{title:'Dashboard'}) %><div class="welcome"><div><span class="eyebrow light">PUSAT INFORMASI LINGKUNGAN</span><h1>Selamat datang, <%= user.name.split(' ')[0] %> 👋</h1><p>Kelola data dan layanan warga dalam satu tempat.</p></div><div class="welcome-mark">⌂</div></div>
<div class="stats-grid">
<div class="stat-card"><div class="stat-icon blue">♙</div><div><span>Total Warga Aktif</span><strong><%= totals.total||0 %></strong><small>Dalam cakupan akses Anda</small></div></div>
<div class="stat-card"><div class="stat-icon green">▣</div><div><span>Kartu Keluarga</span><strong><%= familyCount||0 %></strong><small>Data keluarga</small></div></div>
<div class="stat-card"><div class="stat-icon purple">▤</div><div><span>Surat Diajukan</span><strong><%= recent.length %></strong><small>Aktivitas terbaru</small></div></div>
<div class="stat-card"><div class="stat-icon orange">◎</div><div><span>Total Warga RW <%= user.rw_number %></span><strong><%= rwTotal %></strong><small>Informasi tingkat RW</small></div></div>
</div>
<% if(user.role==='warga'){ %><div class="notice"><span>ⓘ</span><div><b>Informasi lingkungan</b><p>Jumlah warga aktif di RT Anda: <b><%= rtTotal %></b> · Jumlah warga aktif di seluruh RW <%= user.rw_number %>: <b><%= rwTotal %></b>. Data pribadi yang dapat Anda lihat dibatasi pada keluarga sendiri.</p></div></div><% } %>
<div class="two-col"><div class="panel"><div class="panel-head"><div><h3>Aktivitas Surat Terbaru</h3><p>Perkembangan permohonan surat pengantar</p></div><a href="/surat" class="link">Lihat semua →</a></div>
<% if(!recent.length){ %><div class="empty">Belum ada aktivitas surat.</div><% } else { %><div class="activity-list"><% recent.forEach(item=>{ %><div class="activity"><div class="activity-icon">▤</div><div class="activity-body"><b><%= item.letter_type %></b><small><%= item.resident_name %> · <%= new Date(item.created_at).toLocaleDateString('id-ID') %></small></div><span class="status <%= item.status==='Disetujui'?'approved':item.status.startsWith('Ditolak')?'rejected':'pending' %>"><%= item.status %></span></div><% }) %></div><% } %></div>
<div class="panel"><div class="panel-head"><div><h3>Akses Cepat</h3><p>Menu yang sering digunakan</p></div></div><div class="quick-grid"><a href="/surat"><span class="quick-icon blue">＋</span><b>Surat Pengantar</b><small>Ajukan / tinjau surat</small></a><% if(user.role==='warga'){ %><a href="/keluarga-saya"><span class="quick-icon green">▣</span><b>Keluarga Saya</b><small>Lihat anggota keluarga</small></a><% } else { %><a href="/warga"><span class="quick-icon green">♙</span><b>Data Warga</b><small>Kelola data warga</small></a><% } %><a href="/dashboard"><span class="quick-icon purple">▦</span><b>Ringkasan</b><small>Statistik lingkungan</small></a></div></div></div>
<% if(user.role==='rw'){ %><div class="panel"><div class="panel-head"><div><h3>Ringkasan Warga per RT</h3><p>Jumlah warga aktif di masing-masing RT</p></div></div><div class="bar-list"><% rtStats.forEach(s=>{ %><div class="bar-row"><span>RT <%= s.rt_number %></span><div class="bar-track"><div class="bar-fill" style="width:<%= Math.min(100,Number(s.total)/Math.max(1,...rtStats.map(x=>Number(x.total)))*100) %>%"></div></div><b><%= s.total %></b></div><% }) %></div></div><% } %>
<%- include('partials/footer') %>