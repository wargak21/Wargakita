<%- include('partials/header',{title:'Keluarga Saya'}) %><div class="page-heading"><div><h1>Keluarga Saya</h1><p>Informasi keluarga yang terhubung ke akun Anda.</p></div></div><% if(members.length){ %><div class="family-banner"><div class="family-symbol">▣</div><div><span class="eyebrow light">KARTU KELUARGA</span><h2><%= members[0].family_card_number %></h2><p><%= members[0].address %> · RT <%= members[0].rt_number %> / RW <%= members[0].rw_number %></p></div></div><% } %><div class="panel"><div class="panel-head"><div><h3>Anggota Keluarga</h3><p>Informasi pribadi keluarga Anda saja.</p></div><span class="count-pill"><%= members.length %> anggota</span></div><div class="table-wrap"><table><thead><tr><th>No</th><th>Nama</th><th>NIK</th><th>Jenis Kelamin</th><th>Status</th></tr></thead><tbody><% members.forEach((m,i)=>{ %><tr><td><%= i+1 %></td><td><b><%= m.name %></b></td><td><%= m.nik %></td><td><%= m.gender %></td><td><span class="status approved"><%= m.status %></span></td></tr><% }) %></tbody></table></div></div><%- include('partials/footer') %>