<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= locals.title ? title + ' · ' : '' %>WargaKita</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
  <script src="/js/app.js" defer></script>
</head>
<body class="<%= (typeof user !== 'undefined' && user) ? 'app' : 'auth' %>">
<% if (typeof user !== 'undefined' && user) { %>
  <%- include('sidebar') %>
  <div class="main-wrap">
    <header class="topbar">
      <button class="icon-btn menu-btn" type="button" data-toggle="sidebar" aria-label="Menu"><%- icon('menu', 22) %></button>
      <div class="topbar-date"><%= todayLong() %></div>
      <div class="topbar-user">
        <div class="avatar"><%= (user.name || '?').charAt(0).toUpperCase() %></div>
        <div class="who"><strong><%= user.name %></strong><small><%= roleLabel(user.role) %></small></div>
        <form method="post" action="/logout">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <button class="icon-btn" type="submit" title="Keluar" aria-label="Keluar"><%- icon('logout') %></button>
        </form>
      </div>
    </header>
    <main class="content">
      <% if (flash) { %><div class="alert alert-<%= flash.type %>"><%= flash.text %></div><% } %>
<% } else { %>
  <main class="auth-main">
<% } %>
